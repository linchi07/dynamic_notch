    "Works with most media apps, including browsers, to detect what's playing. Note: This may be removed in a future macOS version.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Works with most media apps, including browsers, to detect what's playing. Note: This may be removed in a future macOS version."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Works with most media apps, including browsers, to detect what's playing. Note: This may be removed in a future macOS version."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "支持大多数媒体应用（包括浏览器）检测正在播放的内容。注：未来 macOS 版本可能会弃用此接口。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "支援大多數媒體應用程式（包括瀏覽器）偵測正在播放的內容。注意：未來 macOS 版本可能會棄用此介面。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブラウザを含むほとんどのメディアアプリで再生中の内容を検出します。注：今後のmacOSで削除される可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "브라우저를 포함한 대부분의 미디어 앱에서 재생 중인 항목을 감지합니다. 참고: 향후 macOS 버전에서 제거될 수 있습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erkennt die Wiedergabe in den meisten Medien-Apps einschließlich Browsern. Hinweis: Könnte in künftigen macOS-Versionen entfernt werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fonctionne avec la plupart des applications multimédias, y compris les navigateurs. Remarque : peut être supprimé dans une future version de macOS."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Funciona con la mayoría de apps multimedia y navegadores para detectar qué se reproduce. Nota: Puede eliminarse en futuras versiones de macOS."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Funziona con la maggior parte delle app multimediali, inclusi i browser. Nota: potrebbe essere rimosso in future versioni di macOS."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Работает с большинством медиаприложений и браузеров. Примечание: может быть удалено в будущих версиях macOS."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Funciona com a maioria dos apps de mídia e navegadores. Nota: pode ser removido em uma versão futura do macOS."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Działa z większością aplikacji multimedialnych, w tym przeglądarkami. Uwaga: może zostać usunięte w przyszłej wersji macOS."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Neyin çaldığını algılamak için tarayıcılar dahil çoğu medya uygulamasıyla çalışır. Not: Gelecekteki bir macOS sürümünde kaldırılabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Працює з більшістю медіа-додатків і браузерів. Примітка: може бути видалено в майбутній версії macOS."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A legtöbb médiaalkalmazással működik, beleértve a böngészőket is. Megjegyzés: a jövőbeli macOS verziókban megszűnhet."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Funguje s většinou mediálních aplikací včetně prohlížečů. Poznámka: v budoucí verzi macOS může být odstraněno."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعمل مع معظم تطبيقات الوسائط والمتصفحات لاكتشاف ما يتم تشغيله. ملاحظة: قد تتم إزالته في إصدار مستقبلي من macOS."
          }
        }
      }
    },
    "Connects directly to the Spotify app.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connects directly to the Spotify app."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Connects directly to the Spotify app."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "直接连接至 Spotify 客户端。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "直接連接至 Spotify 用戶端。"
          }
        },
        "ja": {
