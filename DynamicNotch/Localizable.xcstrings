    "Unlock advanced features and improve your experience. Upgrade now for more customizations!": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Unlock advanced features and improve your experience. Upgrade now for more customizations!"
