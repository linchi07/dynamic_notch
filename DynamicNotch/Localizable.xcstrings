    "DynamicNotch now works only on the built-in notched display of a supported MacBook Air, MacBook Pro, or MacBook Neo. External displays, desktop Macs, older MacBooks, and closed-lid mode are not supported.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "DynamicNotch now works only on the built-in notched display of a supported MacBook Air, MacBook Pro, or MacBook Neo. External displays, desktop Macs, older MacBooks, and closed-lid mode are not supported."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "DynamicNotch 目前仅适用于支持的 MacBook Air、MacBook Pro 或 MacBook Neo 的内置刘海屏。不支持外接显示器、台式 Mac、老款 MacBook 以及合盖模式。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "DynamicNotch 目前僅支援具有瀏海屏的 MacBook Air、MacBook Pro 或 MacBook Neo 內建螢幕。不支援外接螢幕、桌上型 Mac、舊款 MacBook 以及合蓋模式。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "DynamicNotch は、対応する MacBook Air、MacBook Pro、または MacBook Neo の内蔵ノッチ付きディスプレイでのみ動作します。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعمل DynamicNotch الآن فقط على الشاشة المدمجة ذات النتوء لأجهزة MacBook Air أو MacBook Pro أو MacBook Neo المدعومة."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "DynamicNotch nyní funguje pouze na vestavěném displeji s výřezem podporovaných MacBooků Air, MacBooků Pro nebo MacBooků Neo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "DynamicNotch funktioniert jetzt nur auf dem integrierten Notch-Display unterstützter MacBook Air, MacBook Pro oder MacBook Neo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "DynamicNotch ahora solo funciona en la pantalla con notch integrada de los MacBook Air, MacBook Pro o MacBook Neo compatibles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "DynamicNotch fonctionne désormais uniquement sur l'écran intégré à encoche des MacBook Air, MacBook Pro ou MacBook Neo compatibles."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A DynamicNotch mostantól csak a támogatott MacBook Air, MacBook Pro vagy MacBook Neo beépített, notchcsal rendelkező kijelzőjén működik."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "DynamicNotch ora funziona solo sul display integrato con notch dei MacBook Air, MacBook Pro o MacBook Neo supportati."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "DynamicNotch는 이제 지원되는 MacBook Air, MacBook Pro 또는 MacBook Neo의 노치가 있는 내장 디스플레이에서만 작동합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "DynamicNotch działa teraz tylko na wbudowanym ekranie z notchem w obsługiwanych MacBookach Air, MacBookach Pro lub MacBookach Neo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O DynamicNotch agora funciona apenas na tela integrada com notch dos modelos suportados do MacBook Air, MacBook Pro ou MacBook Neo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "DynamicNotch теперь работает только на встроенном дисплее с вырезом поддерживаемых MacBook Air, MacBook Pro или MacBook Neo."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "DynamicNotch artık yalnızca desteklenen MacBook Air, MacBook Pro veya MacBook Neo'nun yerleşik çentikli ekranında çalışır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "DynamicNotch тепер працює лише на вбудованому екрані з вирізом сумісних MacBook Air, MacBook Pro або MacBook Neo."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "DynamicNotch now works only on the built-in notched display of a supported MacBook Air, MacBook Pro, or MacBook Neo. External displays, desktop Macs, older MacBooks, and closed-lid mode are not supported."
          }
        }
      }
    },
