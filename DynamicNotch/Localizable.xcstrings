    "Requires a third-party client with API plugin enabled.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Requires a third-party client with API plugin enabled."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Requires a third-party client with API plugin enabled."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要安装已启用 API 插件的第三方客户端。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "需要安裝已啟用 API 外掛程式的第三方用戶端。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "APIプラグインが有効なサードパーティ製クライアントが必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "API 플러그인이 활성화된 서드파티 클라이언트가 필요합니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erfordert einen Drittanbieter-Client mit aktiviertem API-Plugin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nécessite un client tiers avec le plugin API activé."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Requiere un cliente de terceros con el complemento de API habilitado."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Richiede un client di terze parti con plugin API abilitato."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Требуется сторонний клиент с включенным плагином API."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Requer um cliente de terceiros com o plug-in de API ativado."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wymaga klienta innej firmy z włączoną wtyczką API."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "API eklentisi etkinleştirilmiş bir üçüncü taraf istemcisi gerektirir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Потрібен сторонній клієнт із увімкненим плагіном API."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Harmadik féltől származó kliens szükséges bekapcsolt API beépülő modullal."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyžaduje klienta třetí strany s povoleným modulem API."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتطلب عميل جهة خارجية مع تمكين مكون API الإضافي."
          }
        }
      }
