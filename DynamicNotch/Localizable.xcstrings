            "state": "translated",
            "value": "Si collega direttamente all'app Spotify."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключается напрямую к приложению Spotify."
          }
        },
        "pt-BR": {
          "stringUnit": {
