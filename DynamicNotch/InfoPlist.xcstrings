    "NSAppleEventsUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dynamic Notch uses AppleScript to control music players like Apple Music and Spotify, displaying track info and album art in the notch."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dynamic Notch 需要通过 AppleScript 控制 Apple Music 和 Spotify 等播放器，以便在刘海中显示播放进度与专辑封面。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dynamic Notch 需要透過 AppleScript 控制 Apple Music 與 Spotify 等播放器，以便在瀏海中顯示播放進度與專輯封面。"
          }
        }
      }
    },
